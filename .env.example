# Local M2 deployment; copy to .env and supply your GitHub App values.
# Generate distinct random secrets (at least 32 characters); never commit .env/key.
AGENTCI_REPOSITORY=alimobrem/agentci
AGENTCI_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGENTCI_PUBLIC_URL=http://localhost:3000
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
GITHUB_PRIVATE_KEY_FILE=/absolute/path/outside/repository/github-app.pem
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
AGENTCI_EVIDENCE_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
TEMPORAL_NAMESPACE=default
# Controller public provenance only. The separate evaluator must use the same pin.
AGENTCI_EVAL_RUNNER_IMAGE=REPLACE_WITH_IMMUTABLE_RUNNER_IMAGE_OR_DIGEST
# Optional engines/provider identities; provider endpoints/auth stay evaluator-only.
# AGENTCI_EVAL_ENGINES_IMAGE=REPLACE_WITH_IMMUTABLE_ENGINES_IMAGE_OR_DIGEST
AGENTCI_EVAL_PROVIDER_IDENTITIES=[]
AGENTCI_EVAL_MAX_UNITS=128
AGENTCI_EVAL_MAX_TOTAL_TRIALS=2000
AGENTCI_EVAL_REVIEW_TIMEOUT_MS=86400000

# M2 release default; Podman development requires its separate image and socket.
AGENTCI_CONTAINER_ENGINE=docker

# M3 reproduction development opt-in: keep unset in the released M2 deployment.
# Use deploy/reproduction.compose.yaml to mount an operator-owned catalog read-only.
# Apply config explicitly with the packaged deployment operator command first.
# AGENTCI_REPRODUCTION_CATALOG_FILE=/absolute/path/outside/repository/catalog.json
# AGENTCI_REPRODUCTION_CATALOG_DIGEST=sha256:REPLACE_WITH_CANONICAL_CATALOG_DIGEST
# AGENTCI_REPRODUCTION_CONFIG_REVISION=1
# AGENTCI_REPRODUCTION_CONFIG_DIGEST=sha256:REPLACE_WITH_CANONICAL_CONFIG_DIGEST
# AGENTCI_CURSOR_KEY=REPLACE_WITH_DISTINCT_RANDOM_CURSOR_KEY

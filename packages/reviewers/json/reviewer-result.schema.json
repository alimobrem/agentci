{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.dev/schemas/reviewer-result-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "mode": {
      "enum": [
        "synthetic",
        "external"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "uuid"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "organizationId",
        "repository",
        "pullRequest",
        "baseSha",
        "headSha"
      ]
    },
    "role": {
      "enum": [
        "specification-compliance",
        "code-correctness",
        "architecture",
        "security",
        "adversarial",
        "test-eval-completeness",
        "operational-reliability"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "completed",
        "refused",
        "incomplete"
      ]
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "synthetic",
            "external"
          ]
        },
        "differentProvider": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "distinct-upstreams",
            "not-required"
          ]
        },
        "reviewerUpstream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "codingUpstream": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenanceDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "differentProvider",
        "outcome",
        "reviewerUpstream",
        "codingUpstream",
        "provenanceDigest"
      ]
    },
    "coding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "headSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "evidenceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "providerId",
            "model",
            "headSha",
            "evidenceDigest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "promptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "responseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "refused",
            "incomplete"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 524288
        },
        "structuredOutput": {},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "costUsdMicros": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "costKind": {
              "enum": [
                "reported",
                "estimated",
                "unknown"
              ]
            },
            "pricingRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "costUsdMicros",
            "costKind",
            "pricingRevision"
          ]
        },
        "observedModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "providerRequestId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "text",
        "structuredOutput",
        "usage",
        "observedModel",
        "providerRequestId"
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verification": {
              "const": "proposed"
            },
            "output": {}
          },
          "required": [
            "verification",
            "output"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "subject",
    "role",
    "requestId",
    "attemptId",
    "provider",
    "model",
    "status",
    "independence",
    "coding",
    "authorizationDigest",
    "configDigest",
    "promptDigest",
    "contextDigest",
    "requestDigest",
    "responseDigest",
    "response",
    "proposal"
  ]
}

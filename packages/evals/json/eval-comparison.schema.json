{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agentci.io/v1alpha1"
    },
    "kind": {
      "const": "EvalComparison"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "reviewId": {
      "type": "string",
      "format": "uuid"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "pullRequest",
        "baseSha",
        "headSha"
      ],
      "additionalProperties": false
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "suite": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "side": {
            "enum": [
              "base",
              "head"
            ]
          },
          "assertionSide": {
            "enum": [
              "base",
              "head"
            ]
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "trials": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "scenarioIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
            },
            "maxItems": 1000,
            "minItems": 1,
            "uniqueItems": true
          },
          "runnerImage": {
            "type": "string",
            "pattern": "^(?:sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9._/:~-]*@sha256:[a-f0-9]{64})$"
          },
          "runnerProvider": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "cancelled"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "const": "agentci.io/v1alpha1"
              },
              "kind": {
                "const": "EvalRun"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "suite": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "subject": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "gitSha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "assertionGitSha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "inputDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "omittedInputs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 10000,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "repository",
                  "gitSha",
                  "assertionGitSha",
                  "inputDigest",
                  "omittedInputs"
                ],
                "additionalProperties": false
              },
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
              },
              "trials": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "error",
                  "insufficient"
                ]
              },
              "scenarios": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
                    },
                    "passed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "errors": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "skipped": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "criticalFailures": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "status": {
                      "enum": [
                        "passed",
                        "failed",
                        "error",
                        "insufficient"
                      ]
                    },
                    "passRate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "confidenceInterval": {
                      "type": "object",
                      "properties": {
                        "lower": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "upper": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "level": {
                          "enum": [
                            0.9,
                            0.95,
                            0.99
                          ]
                        },
                        "method": {
                          "const": "wilson"
                        }
                      },
                      "required": [
                        "lower",
                        "upper",
                        "level",
                        "method"
                      ],
                      "additionalProperties": false
                    },
                    "metrics": {
                      "type": "object",
                      "properties": {
                        "p95LatencyMs": {
                          "type": "number",
                          "minimum": 0
                        },
                        "avgCostUsd": {
                          "type": "number",
                          "minimum": 0
                        },
                        "totalTokens": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "passed",
                    "failed",
                    "errors",
                    "skipped",
                    "criticalFailures",
                    "status"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "mediaType": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "uri": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "digest",
                    "mediaType",
                    "uri"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "runnerImage": {
                "type": "string",
                "pattern": "^(?:sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9._/:~-]*@sha256:[a-f0-9]{64})$"
              },
              "runnerProvider": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "revision"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "apiVersion",
              "kind",
              "id",
              "suite",
              "revision",
              "subject",
              "trials",
              "status",
              "scenarios",
              "artifacts"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "runnerImage": {},
                  "runnerProvider": false
                },
                "required": [
                  "runnerImage"
                ]
              },
              {
                "properties": {
                  "runnerProvider": {},
                  "runnerImage": false
                },
                "required": [
                  "runnerProvider"
                ]
              }
            ]
          },
          "passRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxCriticalFailures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "id",
          "suite",
          "revision",
          "side",
          "assertionSide",
          "trials",
          "scenarioIds",
          "status",
          "passRate",
          "maxCriticalFailures"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "runnerImage"
            ],
            "properties": {
              "runnerProvider": false,
              "runnerImage": {}
            }
          },
          {
            "required": [
              "runnerProvider"
            ],
            "properties": {
              "runnerImage": false,
              "runnerProvider": {}
            }
          }
        ]
      },
      "maxItems": 10000
    },
    "suiteChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suite": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "kind": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "baseRevision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "headRevision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "removedScenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 10000,
            "uniqueItems": true
          },
          "addedScenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 10000,
            "uniqueItems": true
          }
        },
        "required": [
          "suite",
          "kind",
          "removedScenarios",
          "addedScenarios"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "coverageGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "selectionGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "queued",
            "running",
            "completed",
            "cancelled"
          ]
        },
        "outcome": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "error",
            "insufficient",
            "no-evals"
          ]
        },
        "executionGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "suite": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
              },
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
              },
              "baseRunId": {
                "type": "string",
                "format": "uuid"
              },
              "headRunId": {
                "type": "string",
                "format": "uuid"
              },
              "deltas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scenario": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
                    },
                    "baseStatus": {
                      "enum": [
                        "passed",
                        "failed",
                        "error",
                        "insufficient"
                      ]
                    },
                    "headStatus": {
                      "enum": [
                        "passed",
                        "failed",
                        "error",
                        "insufficient"
                      ]
                    },
                    "passRateDelta": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "criticalFailureDelta": {
                      "type": "integer"
                    },
                    "regression": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "scenario",
                    "baseStatus",
                    "headStatus",
                    "criticalFailureDelta",
                    "regression"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 1000
              },
              "regressions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 10000,
                "uniqueItems": true
              }
            },
            "required": [
              "suite",
              "baseRunId",
              "headRunId",
              "deltas",
              "regressions"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "state",
        "outcome",
        "executionGaps",
        "comparisons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "reviewId",
    "attemptId",
    "organizationId",
    "subject",
    "cancelRequested",
    "units",
    "suiteChanges",
    "coverageGaps",
    "selectionGaps",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.io/schemas/v1alpha1/eval-comparison.schema.json"
}

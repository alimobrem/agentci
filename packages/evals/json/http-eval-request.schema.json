{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.io/schemas/v1alpha1/http-eval-request.schema.json",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agentci.io/v1alpha1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "suiteRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "providerRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "kind": {
      "const": "HttpEvalRequest"
    },
    "suite": {
      "$ref": "https://agentci.io/schemas/v1alpha1/eval-suite.schema.json"
    },
    "files": {
      "type": "object",
      "maxProperties": 10000,
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "maxLength": 2097152
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "requestId",
    "sourceSha",
    "inputDigest",
    "suiteRevision",
    "providerRevision",
    "suite",
    "files"
  ],
  "additionalProperties": false
}

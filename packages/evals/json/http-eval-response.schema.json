{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.io/schemas/v1alpha1/http-eval-response.schema.json",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agentci.io/v1alpha1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "suiteRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "providerRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "kind": {
      "const": "HttpEvalResponse"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "totalTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scenario",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "requestId",
    "sourceSha",
    "inputDigest",
    "suiteRevision",
    "providerRevision",
    "results"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.io/schemas/v1alpha1/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Organization",
        "Project",
        "Repository",
        "Branch",
        "PullRequest",
        "Commit",
        "Requirement",
        "SpecRevision",
        "Capability",
        "Permission",
        "ToolDefinition",
        "PromptRevision",
        "PolicyRevision",
        "ModelRoute",
        "EvalSuite",
        "EvalScenario",
        "EvalRun",
        "Trace",
        "Finding",
        "Build",
        "Artifact",
        "Attestation",
        "AgentRelease",
        "Deployment",
        "ProductionOutcome",
        "Incident",
        "Regression",
        "RepairAttempt",
        "Approval"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"
        },
        "repositoryId": {
          "type": "string",
          "format": "uuid"
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "incidentId": {
          "type": "string",
          "format": "uuid"
        },
        "requirementId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        }
      },
      "required": [
        "gitSha"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "static-analysis",
            "test",
            "eval",
            "model-review",
            "policy",
            "replay",
            "production",
            "human"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "asserted",
            "inferred",
            "verified",
            "inconclusive"
          ]
        },
        "producer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sourceType",
        "confidence",
        "verificationStatus",
        "producer"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "uri",
          "digest",
          "mediaType"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "CONTAINS",
              "IMPLEMENTS",
              "VERIFIES",
              "EXECUTED_AGAINST",
              "PRODUCED_BY",
              "OBSERVED_IN",
              "CORRELATED_WITH",
              "DERIVED_FROM",
              "FIXES",
              "ATTESTED_BY",
              "DEPLOYS"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Organization",
                  "Project",
                  "Repository",
                  "Branch",
                  "PullRequest",
                  "Commit",
                  "Requirement",
                  "SpecRevision",
                  "Capability",
                  "Permission",
                  "ToolDefinition",
                  "PromptRevision",
                  "PolicyRevision",
                  "ModelRoute",
                  "EvalSuite",
                  "EvalScenario",
                  "EvalRun",
                  "Trace",
                  "Finding",
                  "Build",
                  "Artifact",
                  "Attestation",
                  "AgentRelease",
                  "Deployment",
                  "ProductionOutcome",
                  "Incident",
                  "Regression",
                  "RepairAttempt",
                  "Approval"
                ]
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "relation",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "kind",
    "version",
    "createdAt",
    "subject",
    "claim",
    "artifacts",
    "edges"
  ],
  "additionalProperties": false
}

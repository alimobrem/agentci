{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.dev/schemas/model-request-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "system": {
      "type": "string",
      "maxLength": 65536
    },
    "developer": {
      "type": "string",
      "maxLength": 65536
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 131072
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "toolCalls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "arguments"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$"
                },
                "arguments": {
                  "type": "object",
                  "maxProperties": 128
                }
              }
            }
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "inputSchema": {
            "type": "object",
            "maxProperties": 128
          }
        },
        "required": [
          "name",
          "description",
          "inputSchema"
        ]
      }
    },
    "responseSchema": {
      "type": [
        "object",
        "null"
      ],
      "maxProperties": 128
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "topP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stop": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "required": [
        "maxOutputTokens"
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadlineAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "baseDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "deadlineAt",
        "maxAttempts",
        "baseDelayMs",
        "maxDelayMs"
      ]
    },
    "providerExtensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "provider",
    "model",
    "system",
    "developer",
    "messages",
    "tools",
    "responseSchema",
    "parameters",
    "metadata",
    "policy",
    "providerExtensions"
  ]
}

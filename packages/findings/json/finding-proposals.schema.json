{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentci.dev/schemas/finding-proposals-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "specification",
              "correctness",
              "architecture",
              "security",
              "adversarial",
              "test-coverage",
              "reliability"
            ]
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "enum": [
                    "base",
                    "head"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "side",
                "path",
                "digest",
                "startLine",
                "endLine"
              ]
            }
          }
        },
        "required": [
          "category",
          "severity",
          "claim",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "findings"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "v1alpha1"
      ]
    },
    "repository": {
      "type": "string"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "source",
                "specification",
                "requirement",
                "model",
                "tool",
                "permission",
                "policy",
                "prompt",
                "dependency",
                "api",
                "data-schema",
                "deployment",
                "eval"
              ]
            }
          },
          "beforeDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "afterDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "added",
                    "removed",
                    "modified"
                  ]
                },
                "beforeDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "afterDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "pointer",
                "operation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "operation",
          "categories",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          },
          "claim": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "inferred"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirementId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule",
          "severity",
          "claim",
          "verification",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "advisory": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "evals": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-applicable"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "baseSha",
    "headSha",
    "changes",
    "findings",
    "risk",
    "advisory",
    "evals"
  ],
  "additionalProperties": false
}

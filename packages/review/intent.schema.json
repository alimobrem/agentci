{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "subject",
    "summary",
    "classification",
    "source",
    "producer",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "v1alpha1"
      ]
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizationId",
        "repository",
        "pullRequest",
        "baseSha",
        "headSha"
      ],
      "properties": {
        "organizationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "classification": {
      "type": "string",
      "enum": [
        "asserted"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "gitSha",
        "blobSha",
        "contentDigest",
        "bytes",
        "content"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository-declaration"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            ".agentci/intent.json"
          ]
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "blobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12288
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12288
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "agentci"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

{
  "name": "agentci",
  "version": "0.1.0-m0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17" },
  "bin": { "agentci": "dist/cmd/agentci/main.js" },
  "files": ["dist", "agentci.yaml", "specs", "docs", "README.md", "CHANGELOG.md"],
  "scripts": {
    "agentci": "node --import tsx cmd/agentci/main.ts",
    "api": "node --import tsx apps/api/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "status": "node --import tsx scripts/status.ts",
    "eval:contracts": "node --import tsx scripts/eval-contracts.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run eval:contracts && npm run agentci -- validate && npm run status -- --check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

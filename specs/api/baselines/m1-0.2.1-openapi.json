{
  "openapi": "3.0.3",
  "info": {
    "title": "AgentCI M1 control API",
    "version": "0.2.1-m1",
    "description": "Single-repository semantic PR review and authenticated immutable evidence. Customer onboarding extension in progress; no multi-tenant hosting claim."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Service state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/github": {
      "post": {
        "operationId": "ingestGitHubWebhook",
        "description": "Verify HMAC SHA-256 over exact raw body bytes. The X-GitHub-Delivery UUID is the idempotency key; conflicting event/body reuse returns 409. Accept only the configured installation/repository. Record unsupported events as ignored. At most 1 MiB. 202 means durably received, not reviewed. GitHub payload schema is provider-owned; pull_request events require number, action and base/head commit identities.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Hub-Signature-256",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-GitHub-Delivery",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-GitHub-Event",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deliveryId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "ignored",
                        "duplicate"
                      ]
                    }
                  },
                  "required": [
                    "deliveryId",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, headers or PR payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Installation/repository mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Delivery identity conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Persistence unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed; Allow header advertises the supported method",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence/{id}": {
      "get": {
        "operationId": "getEvidence",
        "security": [
          {
            "evidenceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable evidence in configured repository; digest hashes canonical JSON analysis with recursively sorted object keys.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid evidence UUID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Evidence unavailable in repository",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Persistence unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed; Allow header advertises the supported method",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "evidenceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Analysis": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "v1alpha1"
            ]
          },
          "repository": {
            "type": "string"
          },
          "baseSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "headSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "added",
                    "removed",
                    "modified"
                  ]
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "source",
                      "specification",
                      "requirement",
                      "model",
                      "tool",
                      "permission",
                      "policy",
                      "prompt",
                      "dependency",
                      "api",
                      "data-schema",
                      "deployment",
                      "eval"
                    ]
                  }
                },
                "beforeDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "afterDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pointer": {
                        "type": "string"
                      },
                      "operation": {
                        "type": "string",
                        "enum": [
                          "added",
                          "removed",
                          "modified"
                        ]
                      },
                      "beforeDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "afterDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "pointer",
                      "operation"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "path",
                "operation",
                "categories",
                "fields"
              ],
              "additionalProperties": false
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "verification": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "inferred"
                  ]
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requirementId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "rule",
                "severity",
                "claim",
                "verification",
                "paths"
              ],
              "additionalProperties": false
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "advisory": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "evals": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schemaVersion",
          "repository",
          "baseSha",
          "headSha",
          "changes",
          "findings",
          "risk",
          "advisory",
          "evals"
        ],
        "additionalProperties": false
      },
      "EvidenceRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "evidence": {
            "title": "evidence",
            "type": "object",
            "properties": {
              "schemaVersion": {
                "enum": [
                  "v1alpha1"
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "organizationId": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "Organization",
                  "Project",
                  "Repository",
                  "Branch",
                  "PullRequest",
                  "Commit",
                  "Requirement",
                  "SpecRevision",
                  "Capability",
                  "Permission",
                  "ToolDefinition",
                  "PromptRevision",
                  "PolicyRevision",
                  "ModelRoute",
                  "EvalSuite",
                  "EvalScenario",
                  "EvalRun",
                  "Trace",
                  "Finding",
                  "Build",
                  "Artifact",
                  "Attestation",
                  "AgentRelease",
                  "Deployment",
                  "ProductionOutcome",
                  "Incident",
                  "Regression",
                  "RepairAttempt",
                  "Approval"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "subject": {
                "type": "object",
                "properties": {
                  "gitSha": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"
                  },
                  "repositoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "pullRequest": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "releaseId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "incidentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "requirementId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
                  }
                },
                "required": [
                  "gitSha"
                ],
                "additionalProperties": false
              },
              "claim": {
                "type": "object",
                "properties": {
                  "sourceType": {
                    "type": "string",
                    "enum": [
                      "static-analysis",
                      "test",
                      "eval",
                      "model-review",
                      "policy",
                      "replay",
                      "production",
                      "human"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "verificationStatus": {
                    "type": "string",
                    "enum": [
                      "asserted",
                      "inferred",
                      "verified",
                      "inconclusive"
                    ]
                  },
                  "producer": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "sourceType",
                  "confidence",
                  "verificationStatus",
                  "producer"
                ],
                "additionalProperties": false
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "uri"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "mediaType": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "uri",
                    "digest",
                    "mediaType"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "relation": {
                      "type": "string",
                      "enum": [
                        "CONTAINS",
                        "IMPLEMENTS",
                        "VERIFIES",
                        "EXECUTED_AGAINST",
                        "PRODUCED_BY",
                        "OBSERVED_IN",
                        "CORRELATED_WITH",
                        "DERIVED_FROM",
                        "FIXES",
                        "ATTESTED_BY",
                        "DEPLOYS"
                      ]
                    },
                    "target": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "Organization",
                            "Project",
                            "Repository",
                            "Branch",
                            "PullRequest",
                            "Commit",
                            "Requirement",
                            "SpecRevision",
                            "Capability",
                            "Permission",
                            "ToolDefinition",
                            "PromptRevision",
                            "PolicyRevision",
                            "ModelRoute",
                            "EvalSuite",
                            "EvalScenario",
                            "EvalRun",
                            "Trace",
                            "Finding",
                            "Build",
                            "Artifact",
                            "Attestation",
                            "AgentRelease",
                            "Deployment",
                            "ProductionOutcome",
                            "Incident",
                            "Regression",
                            "RepairAttempt",
                            "Approval"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "relation",
                    "target"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "extensions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              }
            },
            "required": [
              "schemaVersion",
              "id",
              "organizationId",
              "kind",
              "version",
              "createdAt",
              "subject",
              "claim",
              "artifacts",
              "edges"
            ],
            "additionalProperties": false
          },
          "analysis": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "enum": [
                  "v1alpha1"
                ]
              },
              "repository": {
                "type": "string"
              },
              "baseSha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
              },
              "headSha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "operation": {
                      "type": "string",
                      "enum": [
                        "added",
                        "removed",
                        "modified"
                      ]
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "source",
                          "specification",
                          "requirement",
                          "model",
                          "tool",
                          "permission",
                          "policy",
                          "prompt",
                          "dependency",
                          "api",
                          "data-schema",
                          "deployment",
                          "eval"
                        ]
                      }
                    },
                    "beforeDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "afterDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pointer": {
                            "type": "string"
                          },
                          "operation": {
                            "type": "string",
                            "enum": [
                              "added",
                              "removed",
                              "modified"
                            ]
                          },
                          "beforeDigest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "afterDigest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "pointer",
                          "operation"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "path",
                    "operation",
                    "categories",
                    "fields"
                  ],
                  "additionalProperties": false

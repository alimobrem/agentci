# Copy outside Git to evaluator.env; chmod 600. Never use the controller .env here.
AGENTCI_REPOSITORY=alimobrem/agentci
AGENTCI_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGENTCI_EVAL_WORKER_IMAGE=REPLACE_WITH_IMMUTABLE_EVALUATOR_SERVICE_IMAGE
AGENTCI_EVAL_RUNNER_IMAGE=REPLACE_WITH_IMMUTABLE_RUNNER_IMAGE
# Optional engine runner must match the controller pin.
# AGENTCI_EVAL_ENGINES_IMAGE=REPLACE_WITH_IMMUTABLE_ENGINES_IMAGE
AGENTCI_EVAL_DATABASE_URL=postgresql://DATABASE_HOST:5432/agentci
AGENTCI_EVAL_PGUSER=agentci_evaluator
AGENTCI_EVAL_PGPASSWORD=REPLACE_WITH_DISTINCT_RANDOM_SECRET
AGENTCI_EVAL_TEMPORAL_ADDRESS=TEMPORAL_HOST:7233
TEMPORAL_NAMESPACE=default
# Podman is the preferred dedicated executor. Docker requires an explicit engine override.
AGENTCI_CONTAINER_ENGINE=podman
AGENTCI_CONTAINER_SOCKET_PATH=/run/user/1001/podman/podman.sock
AGENTCI_CONTAINER_SOCKET_GID=REPLACE_WITH_ENGINE_SOCKET_GID
# Private regular file, mode 0600, readable by UID 1001; [] when HTTP is unused.
AGENTCI_EVAL_PROVIDERS_FILE=/absolute/private/path/eval-providers.json
